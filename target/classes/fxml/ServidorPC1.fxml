<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="screen-root" prefHeight="620.0" prefWidth="960.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ServidorPC1Controller">
    <stylesheets>
        <URL value="@../styles/servidorpc1.css"/>
    </stylesheets>

    <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="14">
        <FontIcon iconLiteral="fas-server" iconSize="22" styleClass="header-icon"/>
        <VBox spacing="2">
            <Label text="SERVIDOR CENTRAL · PC1" styleClass="header-title"/>
            <Label text="Sistema de Soporte IT" styleClass="header-subtitle"/>
        </VBox>
        <Pane HBox.hgrow="ALWAYS"/>
        <HBox styleClass="status-pill-offline" alignment="CENTER" spacing="8">
            <Circle fx:id="ledEstado" radius="5" styleClass="led-offline"/>
            <Label text="OFFLINE" styleClass="status-pill-label-offline"/>
        </HBox>
    </HBox>

    <SplitPane styleClass="split-dark" dividerPositions="0.175, 0.62" VBox.vgrow="ALWAYS">

        <VBox styleClass="sidebar" spacing="20" minWidth="140" maxWidth="180">
            <padding><Insets top="20" right="14" bottom="20" left="14"/></padding>

            <VBox spacing="8">
                <Label text="SERVIDOR" styleClass="section-label"/>
                <Button fx:id="btnStart" onAction="#iniciarServidor" text="INICIAR"
                        styleClass="btn-iniciar" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="8">
                    <graphic><FontIcon iconLiteral="fas-play" iconSize="10"/></graphic>
                </Button>
                <Button fx:id="btnStop" onAction="#detenerServidor" text="DETENER"
                        styleClass="btn-ghost" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="8">
                    <graphic><FontIcon iconLiteral="fas-stop" iconSize="10"/></graphic>
                </Button>
            </VBox>

            <VBox spacing="8">
                <Label text="COLAS" styleClass="section-label"/>
                <HBox styleClass="counter-card" spacing="12" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-list" iconSize="14" styleClass="icon-ghost"/>
                    <VBox spacing="2">
                        <Label text="Normal" styleClass="muted-label"/>
                        <Label fx:id="lblColaNormal" text="0" styleClass="counter-value"/>
                    </VBox>
                </HBox>
                <HBox styleClass="counter-card" spacing="12" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-bolt" iconSize="14" styleClass="icon-priority"/>
                    <VBox spacing="2">
                        <Label text="Prioridad" styleClass="muted-label"/>
                        <Label fx:id="lblColaPrioridad" text="0" styleClass="counter-value-priority"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="pc-panel" spacing="14">
            <padding><Insets top="20" right="16" bottom="16" left="16"/></padding>
            <Label text="ESTACIONES CONECTADAS" styleClass="section-label"/>

            <GridPane hgap="10" vgap="10" VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints vgrow="ALWAYS" percentHeight="50"/>
                    <RowConstraints vgrow="ALWAYS" percentHeight="50"/>
                </rowConstraints>

                <VBox fx:id="cardPC2" styleClass="pc-card-offline" spacing="6"
                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon fx:id="iconPC2" iconLiteral="fas-desktop" iconSize="15" styleClass="pc-icon-offline"/>
                        <Label text="PC2" styleClass="pc-card-name"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Circle fx:id="ledPC2" radius="5" styleClass="led-offline"/>
                    </HBox>
                    <Label text="Recepción" styleClass="pc-card-role"/>
                    <Label fx:id="ipPC2" text="---" styleClass="pc-card-ip"/>
                    <Label fx:id="statusPC2" text="OFFLINE" styleClass="pc-status-offline"/>
                </VBox>

                <VBox fx:id="cardPC3" styleClass="pc-card-offline" spacing="6"
                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon fx:id="iconPC3" iconLiteral="fas-desktop" iconSize="15" styleClass="pc-icon-offline"/>
                        <Label text="PC3" styleClass="pc-card-name"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Circle fx:id="ledPC3" radius="5" styleClass="led-offline"/>
                    </HBox>
                    <Label text="Técnico 1" styleClass="pc-card-role"/>
                    <Label fx:id="ipPC3" text="---" styleClass="pc-card-ip"/>
                    <Label fx:id="statusPC3" text="OFFLINE" styleClass="pc-status-offline"/>
                </VBox>

                <VBox fx:id="cardPC4" styleClass="pc-card-offline" spacing="6"
                      GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon fx:id="iconPC4" iconLiteral="fas-desktop" iconSize="15" styleClass="pc-icon-offline"/>
                        <Label text="PC4" styleClass="pc-card-name"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Circle fx:id="ledPC4" radius="5" styleClass="led-offline"/>
                    </HBox>
                    <Label text="Técnico 2" styleClass="pc-card-role"/>
                    <Label fx:id="ipPC4" text="---" styleClass="pc-card-ip"/>
                    <Label fx:id="statusPC4" text="OFFLINE" styleClass="pc-status-offline"/>
                </VBox>

                <VBox fx:id="cardPC5" styleClass="pc-card-offline" spacing="6"
                      GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon fx:id="iconPC5" iconLiteral="fas-desktop" iconSize="15" styleClass="pc-icon-offline"/>
                        <Label text="PC5" styleClass="pc-card-name"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Circle fx:id="ledPC5" radius="5" styleClass="led-offline"/>
                    </HBox>
                    <Label text="Técnico 3" styleClass="pc-card-role"/>
                    <Label fx:id="ipPC5" text="---" styleClass="pc-card-ip"/>
                    <Label fx:id="statusPC5" text="OFFLINE" styleClass="pc-status-offline"/>
                </VBox>
            </GridPane>
        </VBox>

        <VBox styleClass="log-panel" minWidth="200">
            <HBox styleClass="log-header" alignment="CENTER_LEFT" spacing="8">
                <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
                <FontIcon iconLiteral="fas-terminal" iconSize="12" styleClass="icon-secondary"/>
                <Label text="LOG DE ACTIVIDAD" styleClass="section-label"/>
            </HBox>
            <TextArea fx:id="txtLog" editable="false" styleClass="log-area" VBox.vgrow="ALWAYS"/>
        </VBox>

    </SplitPane>
</VBox>